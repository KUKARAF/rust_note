# Rust
/target/
**/target/
*.pdb

# Node / web frontend
node_modules/
web/build/
web/.svelte-kit/
.svelte-kit/
dist/

# Excalidraw fonts — copied from node_modules into static/ by
# web/scripts/copy-excalidraw-assets.mjs (runs on `npm run prepare`)
web/static/excalidraw-assets/

# Env / secrets
.env
.env.*
*.env

# Runtime data (dev server: sqlite + git-backed notes repo)
/data/

# Databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Claude Code local state
.claude/settings.local.json
.claude/scheduled_tasks.lock

# IDE
.vscode/
.idea/
*.iml
.DS_Store

# Logs
*.log

# Tauri Android scaffolding is generated in CI by `tauri android init`
crates/mobile/gen/

# Android signing keys - never commit
*.keystore
*.jks
